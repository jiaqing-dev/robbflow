FROM python:3.12-slim
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock* ./
COPY apps ./apps
COPY packages ./packages
RUN uv sync --frozen --no-dev --package robbflow-api || uv sync --no-dev --package robbflow-api
EXPOSE 8000
CMD ["uv", "run", "--package", "robbflow-api", "uvicorn", "robbflow_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
